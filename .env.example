# Copy to .env, then generate a key: bunx emdash secrets generate --write .env --force
# Keep the real key secret and back it up together with the database.
EMDASH_ENCRYPTION_KEY=

# Postgres connection string, read at runtime (db-env.mjs). Matches docker-compose.yml.
DATABASE_URL=postgres://emdash:emdash@localhost:5432/emdash

# Public URL when served behind HTTPS (deployments). Unset locally.
# EMDASH_SITE_URL=https://example.com

# S3-compatible media storage. Unset → local ./uploads (src/storage.mjs).
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=   # "false" → <bucket>.<host> requests; unset → path-style
# S3_PUBLIC_URL=

# Optional host ports for docker-compose.yml
# POSTGRES_PORT=5432
# APP_PORT=4321
